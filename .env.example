# Node Identity
NODE_ID=node-01
REGION=us-east-1

# Security
# Shared by the nginx edge and the control plane to sign/verify playback URLs.
# MUST be changed to a long random value, e.g. `openssl rand -hex 32`.
SECRET_KEY=change_me_to_a_long_random_secret

# Storage (S3/Wasabi/R2)
S3_ENDPOINT=https://s3.example.com
S3_BUCKET=my-streaming-platform
AWS_ACCESS_KEY_ID=change_me
AWS_SECRET_ACCESS_KEY=change_me
DRY_RUN=false

# Control Plane (Optional - for Webhooks)
CONTROL_PLANE_URL=http://api.platform.com/v1
